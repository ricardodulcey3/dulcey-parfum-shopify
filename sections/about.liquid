<section class="about" id="nosotros">
  <div class="container about__inner">
    <div class="about__text" data-animate>
      <p class="section__kicker">{{ section.settings.kicker }}</p>
      <h2 class="section__title">{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>

      {%- if section.blocks.size > 0 -%}
        <div class="about__stats">
          {%- for block in section.blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <span class="stat__number counter" data-count-to="{{ block.settings.number }}" data-prefix="{{ block.settings.prefix }}" data-suffix="{{ block.settings.suffix }}" data-format="{{ block.settings.format }}">0</span>
              <span class="stat__label">{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="about__visual" data-animate>
      {%- if section.settings.image != blank -%}
        <img class="about__photo" src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="900" height="1125">
      {%- else -%}
        <img class="about__photo" src="{{ 'plate-about.svg' | asset_url }}" alt="" loading="lazy" width="900" height="1125">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nosotros",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Texto pequeño superior", "default": "Nuestra historia" },
    { "type": "text", "id": "title", "label": "Título", "default": "Por qué Lattafa" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "En Dulcey Elixir apostamos por la casa Lattafa: la perfumería de Dubái que llevó el dátil, el oud y la vainilla a todo el mundo. Cada frasco que sale de aquí es original y verificado, elegido por su carácter. Una invitación a expresar tu personalidad sin decir una palabra." },
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Si no subes una, se usa una placa de marca genérica." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        { "type": "number", "id": "number", "label": "Número", "default": 80 },
        { "type": "text", "id": "prefix", "label": "Prefijo" },
        { "type": "text", "id": "suffix", "label": "Sufijo" },
        {
          "type": "select",
          "id": "format",
          "label": "Formato",
          "options": [
            { "value": "", "label": "Normal" },
            { "value": "k", "label": "Miles (2000 → 2K)" }
          ],
          "default": ""
        },
        { "type": "text", "id": "label", "label": "Etiqueta", "default": "Fragancias" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nosotros",
      "blocks": [
        { "type": "stat", "settings": { "number": 80, "prefix": "+", "label": "Fragancias" } },
        { "type": "stat", "settings": { "number": 2000, "suffix": "+", "format": "k", "label": "Clientes felices" } },
        { "type": "stat", "settings": { "number": 100, "suffix": "%", "label": "Originales" } }
      ]
    }
  ]
}
{% endschema %}
