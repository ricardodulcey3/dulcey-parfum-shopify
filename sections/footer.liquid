<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="logo logo--footer">{{ settings.logo_text_1 }} <span>{{ settings.logo_text_2 }}</span></a>
      <p class="footer__desc">{{ section.settings.description }}</p>
      <div class="footer__socials">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">IG</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">FB</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">TT</a>{%- endif -%}
      </div>
    </div>

    <div class="footer__col">
      <h4>Catálogo</h4>
      {%- for link in linklists[section.settings.footer_menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>

    <div class="footer__col">
      <h4>Servicio</h4>
      <a href="{{ pages.politica-de-envios.url | default: '#' }}">Política de envíos</a>
      <a href="{{ pages.devoluciones.url | default: '#' }}">Devoluciones</a>
      <a href="#contacto">Contacto</a>
    </div>

    <div class="footer__col footer__newsletter">
      <h4>Lista privada</h4>
      <p>Lanzamientos antes que nadie y -10% en tu primera compra.</p>
      {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Tu correo" required aria-label="Correo electrónico">
        <button type="submit">Unirme →</button>
        {%- if form.posted_successfully? -%}
          <p class="newsletter__msg show">¡Gracias! Te avisaremos por correo con tu código de -10%.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="container footer__bottom">
    <p class="footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</p>
    <div class="footer__payments">
      {%- for type in shop.enabled_payment_types -%}
        <span>{{ type | replace: '_', ' ' | upcase }}</span>
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Perfumería original para quienes entienden que el aroma es la firma invisible de la presencia."
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Menú del pie de página",
      "default": "footer"
    }
  ]
}
{% endschema %}
