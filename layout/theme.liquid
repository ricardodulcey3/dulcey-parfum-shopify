<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }}{% if page_title != shop.name %} | {{ shop.name }}{% endif %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="{{ 'dulcey-logo-circular-minimo.svg' | asset_url }}" type="image/svg+xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}

<style>
  :root {
    --gold: {{ settings.color_gold }};
    --gold-light: {{ settings.color_gold_light }};
    --black: {{ settings.color_black }};
    --black-soft: {{ settings.color_black_soft }};
    --cream: {{ settings.color_cream }};
  }
</style>
</head>
<body>

{% section 'announcement-bar' %}
{% section 'header' %}

<main id="MainContent">
  {{ content_for_layout }}
</main>

{% section 'footer' %}

{%- if settings.show_whatsapp_float -%}
<a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" class="whatsapp-float" aria-label="Contactar por WhatsApp">
  {% render 'icon-whatsapp', size: 28 %}
</a>
{%- endif -%}

{{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
